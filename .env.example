# PIN numérico ou senha curta para liberar o modo de edição/upload (padrão: 1234)
ADMIN_PIN=1234

# Segredo para assinar o cookie de sessão administrativa (gere uma string aleatória em produção)
AUTH_SECRET=troque-esse-segredo-em-producao

# Opcional: Preenchido automaticamente quando conectado ao Vercel Blob Storage
# BLOB_READ_WRITE_TOKEN=
